# Copy to .env. Synthetic data only: never point this prototype at real client data.
DATABASE_URL="file:./dev.db"

# AI tasks (milestone 2). Without a key, only the seeded demo transcript can be analyzed,
# using pre-written sample output that the review screen labels as such.
ANTHROPIC_API_KEY=""
# Set to "sample" to use the sample output even when a key is set.
AI_MODE=""
# Optional override; the default lives in src/config.ts.
ANTHROPIC_MODEL=""

# Automatic transcript capture from the BTS Zoom account (milestone 3).
# The secret token comes from the Zoom app's Event Subscriptions page. Never commit a real one.
ZOOM_WEBHOOK_SECRET_TOKEN=""
# Local development only: act as Zoom with a synthetic transcript ("Simulate Zoom" button).
# Needs a ZOOM_WEBHOOK_SECRET_TOKEN; any local value works for the simulator.
ZOOM_SIMULATOR="false"

# Slack app (milestone 3). Optional: without it, messages appear in the simulated chat.
# Setup steps: slack/README.md. Never commit real tokens.
SLACK_ENABLED="false"
SLACK_BOT_TOKEN=""
SLACK_APP_TOKEN=""
# Prototype: deliver every Slack-first coachee's messages to this Slack member ID (you).
SLACK_TEST_USER_ID=""
# Base URL for links in Slack messages.
APP_URL="http://localhost:3000"

# Twice-daily nudges at 12:00 and 17:00 in each coachee's time zone.
COMPANION_SCHEDULER="false"

# Microsoft Teams (see teams/README.md). TEAMS_ENABLED alone works with Microsoft 365 Agents
# Playground on this computer. Real Teams also needs the bot's app registration below.
TEAMS_ENABLED="false"
TEAMS_CLIENT_ID=""
TEAMS_CLIENT_SECRET=""
TEAMS_TENANT_ID=""

# BiTSy coaching agents (coaching guidance). Without these, coaches reply with sample answers.
# Use a BiTSy test account; everything sent is synthetic. COACHING_SAMPLE=true forces sample mode.
BITSY_API_URL=""
BITSY_EMAIL=""
BITSY_PASSWORD=""
BITSY_CLIENT_ID=""
COACHING_SAMPLE="false"
