{
  "name": "coaching-companion",
  "version": "0.1.0",
  "private": true,
  "description": "Coaching Session Companion prototype. Synthetic data only.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "ds:sync": "node scripts/sync-ds.mjs",
    "postinstall": "node scripts/sync-ds.mjs && prisma generate",
    "predev": "node scripts/sync-ds.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/sync-ds.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:setup": "prisma db push --skip-generate && node prisma/seed.mts",
    "db:seed": "node prisma/seed.mts"
  },
  "prisma": {
    "seed": "node prisma/seed.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@microsoft/teams.api": "2.1.0",
    "@microsoft/teams.apps": "2.1.0",
    "@microsoft/teams.cards": "2.1.0",
    "@prisma/client": "6.19.3",
    "@slack/bolt": "5.1.0",
    "next": "14.2.35",
    "node-cron": "4.6.0",
    "pdfjs-dist": "6.4.299",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "prisma": "6.19.3",
    "typescript": "5.9.3"
  }
}
